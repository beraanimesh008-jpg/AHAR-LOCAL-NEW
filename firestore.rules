rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'beraanimesh008@gmail.com'
      );
    }

    // --- Validation Blueprints ---
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'language', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'photoUrl', 'language', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role in ['customer', 'restaurant', 'delivery', 'admin']
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.language is string && data.language in ['en', 'bn']
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'dob', 'gender', 'address', 'paymentMethod', 'upiId', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('dob' in data) || (data.dob is string && data.dob.size() <= 20))
        && (!('gender' in data) || (data.gender is string && data.gender in ['Male', 'Female', 'Other', 'Not specified']))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod in ['upi', 'bank', 'cod']))
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 120))
        && data.updatedAt is timestamp;
    }

    function isValidUserCartState(data) {
      return data.keys().hasAll(['uid', 'deliveryAddress', 'deliveryLat', 'deliveryLng', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'restaurantId', 'deliveryAddress', 'deliveryLat', 'deliveryLng', 'updatedAt'])
        && isValidId(data.uid)
        && (!('restaurantId' in data) || (data.restaurantId is string && data.restaurantId.size() <= 128))
        && data.deliveryAddress is string && data.deliveryAddress.size() <= 500
        && data.deliveryLat is number
        && data.deliveryLng is number
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp;
    }

    function isValidRestaurant(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'address', 'latitude', 'longitude', 'isOpen', 'isPureVeg', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'name', 'nameBn', 'address', 'latitude', 'longitude', 'photoUrl', 'isOpen', 'isPureVeg', 'status', 'avgDeliveryMinutes', 'minOrderAmount', 'rating', 'cuisineTypes', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && (!('nameBn' in data) || (data.nameBn is string && data.nameBn.size() <= 160))
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 500
        && data.latitude is number
        && data.longitude is number
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.isOpen is bool
        && data.isPureVeg is bool
        && data.status is string && data.status in ['pending', 'approved', 'rejected', 'blocked']
        && (!('avgDeliveryMinutes' in data) || data.avgDeliveryMinutes is number)
        && (!('minOrderAmount' in data) || data.minOrderAmount is number)
        && (!('rating' in data) || data.rating is number)
        && (!('cuisineTypes' in data) || (data.cuisineTypes is list && data.cuisineTypes.size() <= 10 && (data.cuisineTypes.size() == 0 || (data.cuisineTypes[0] is string && data.cuisineTypes[0].size() <= 60))))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'restaurantId', 'ownerUid', 'name', 'category', 'price', 'isVeg', 'isAvailable', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'restaurantId', 'ownerUid', 'name', 'nameBn', 'category', 'description', 'price', 'photoUrl', 'isVeg', 'isAvailable', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.restaurantId)
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && (!('nameBn' in data) || (data.nameBn is string && data.nameBn.size() <= 160))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && data.price is number && data.price >= 0
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.isVeg is bool
        && data.isAvailable is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'customerUid', 'customerName', 'restaurantId', 'restaurantOwnerUid', 'restaurantName', 'deliveryAddress', 'deliveryLat', 'deliveryLng', 'subtotal', 'deliveryFee', 'discount', 'tax', 'grandTotal', 'paymentMethod', 'paymentStatus', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderNumber', 'customerUid', 'customerName', 'restaurantId', 'restaurantOwnerUid', 'restaurantName', 'deliveryPartnerUid', 'deliveryAddress', 'deliveryLat', 'deliveryLng', 'subtotal', 'deliveryFee', 'discount', 'tax', 'grandTotal', 'paymentMethod', 'paymentStatus', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 64
        && isValidId(data.customerUid)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && isValidId(data.restaurantId)
        && isValidId(data.restaurantOwnerUid)
        && data.restaurantName is string && data.restaurantName.size() >= 1 && data.restaurantName.size() <= 160
        && (!('deliveryPartnerUid' in data) || (data.deliveryPartnerUid is string && data.deliveryPartnerUid.size() <= 128))
        && data.deliveryAddress is string && data.deliveryAddress.size() >= 1 && data.deliveryAddress.size() <= 500
        && data.deliveryLat is number
        && data.deliveryLng is number
        && data.subtotal is number && data.subtotal >= 0
        && data.deliveryFee is number && data.deliveryFee >= 0
        && data.discount is number && data.discount >= 0
        && data.tax is number && data.tax >= 0
        && data.grandTotal is number && data.grandTotal >= 0
        && data.paymentMethod is string && data.paymentMethod in ['cod', 'upi', 'razorpay', 'cashfree']
        && data.paymentStatus is string && data.paymentStatus in ['pending', 'paid', 'failed', 'cod']
        && data.status is string && data.status in ['pending', 'accepted', 'preparing', 'ready', 'assigned', 'picked_up', 'on_the_way', 'delivered', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderLineItem(data) {
      return data.keys().hasAll(['id', 'orderId', 'customerUid', 'restaurantOwnerUid', 'foodId', 'foodName', 'price', 'quantity', 'totalPrice', 'createdAt'])
        && data.keys().hasOnly(['id', 'orderId', 'customerUid', 'restaurantOwnerUid', 'foodId', 'foodName', 'price', 'quantity', 'totalPrice', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.orderId)
        && isValidId(data.customerUid)
        && isValidId(data.restaurantOwnerUid)
        && isValidId(data.foodId)
        && data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 160
        && data.price is number && data.price >= 0
        && data.quantity is number && data.quantity >= 1
        && data.totalPrice is number && data.totalPrice >= 0
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userUid', 'title', 'message', 'type', 'isRead', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userUid', 'title', 'message', 'type', 'isRead', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.userUid)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 600
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 64
        && data.isRead is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Admins allowlist (split write blocks so incoming() is never evaluated on delete)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(userId) && isValidAdminRecord(incoming());
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Users (Split Collection Strategy: public metadata vs private PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().role in ['customer', 'restaurant', 'delivery']
            && incoming().isActive == true
          )
        );

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().isActive == existing().isActive
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'language', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      // Strictly private user PII
      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isVerified()
          && isValidId(userId)
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'dob', 'gender', 'address', 'paymentMethod', 'upiId', 'updatedAt']);

        allow delete: if isAdmin() && isValidId(userId);
      }

      // Private persisted delivery coordinates & cart state
      match /private/cart {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create, update: if isVerified()
          && isValidId(userId)
          && (isOwner(userId) || isAdmin())
          && isValidUserCartState(incoming())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;

        allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
      }
    }

    // Restaurants & Menu subcollection
    match /restaurants/{restaurantId} {
      allow get: if isValidId(restaurantId) && (
        existing().status == 'approved' ||
        (isSignedIn() && existing().ownerUid == request.auth.uid) ||
        isAdmin()
      );

      allow list: if resource.data.status == 'approved' ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
        isAdmin();

      allow create: if isVerified()
        && isValidId(restaurantId)
        && isValidRestaurant(incoming())
        && incoming().id == restaurantId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            incoming().ownerUid == request.auth.uid
            && incoming().status == 'pending'
          )
        );

      allow update: if isVerified()
        && isValidId(restaurantId)
        && isValidRestaurant(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().ownerUid == request.auth.uid
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nameBn', 'address', 'latitude', 'longitude', 'photoUrl', 'isOpen', 'isPureVeg', 'avgDeliveryMinutes', 'minOrderAmount', 'cuisineTypes', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(restaurantId);

      // Menu subcollection (Master Gate checks parent restaurant document)
      match /menu/{foodId} {
        allow get: if isValidId(restaurantId) && isValidId(foodId) && (
          existing().isAvailable == true ||
          (isSignedIn() && existing().ownerUid == request.auth.uid) ||
          isAdmin()
        );

        allow list: if resource.data.isAvailable == true ||
          (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(restaurantId)
          && isValidId(foodId)
          && isValidMenuItem(incoming())
          && incoming().id == foodId
          && incoming().restaurantId == restaurantId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
          && (
            isAdmin() || (
              incoming().ownerUid == request.auth.uid &&
              get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid
            )
          );

        allow update: if isVerified()
          && isValidId(restaurantId)
          && isValidId(foodId)
          && isValidMenuItem(incoming())
          && incoming().id == existing().id
          && incoming().restaurantId == existing().restaurantId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
          && (
            isAdmin() || (
              get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nameBn', 'category', 'description', 'price', 'photoUrl', 'isVeg', 'isAvailable', 'updatedAt'])
            )
          );

        allow delete: if isVerified()
          && isValidId(restaurantId)
          && isValidId(foodId)
          && (
            isAdmin() ||
            get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid
          );
      }
    }

    // Orders & Order Line Items subcollection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        existing().customerUid == request.auth.uid ||
        existing().restaurantOwnerUid == request.auth.uid ||
        existing().deliveryPartnerUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if (
        isSignedIn() && (
          resource.data.customerUid == request.auth.uid ||
          resource.data.restaurantOwnerUid == request.auth.uid ||
          resource.data.deliveryPartnerUid == request.auth.uid
        )
      ) || isAdmin();

      allow create: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().customerUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId))
        && get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerUid == incoming().restaurantOwnerUid;

      allow update: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().customerUid == existing().customerUid
        && incoming().restaurantId == existing().restaurantId
        && incoming().restaurantOwnerUid == existing().restaurantOwnerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            // Terminal state lock for non-admins
            !(existing().status in ['delivered', 'cancelled']) && (
              // Action 1: Customer cancels pending order
              (
                existing().customerUid == request.auth.uid &&
                existing().status == 'pending' &&
                incoming().status == 'cancelled' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) ||
              // Action 2: Restaurant updates kitchen fulfillment status
              (
                existing().restaurantOwnerUid == request.auth.uid &&
                incoming().status in ['accepted', 'preparing', 'ready', 'cancelled'] &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) ||
              // Action 3: Assigned delivery partner updates transit status
              (
                existing().deliveryPartnerUid == request.auth.uid &&
                incoming().status in ['picked_up', 'on_the_way', 'delivered'] &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(orderId);

      // Order line items subcollection (Master Gate + Zero-Read list enforcement)
      match /items/{itemId} {
        allow get: if isValidId(orderId) && isValidId(itemId) && isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantOwnerUid == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryPartnerUid == request.auth.uid ||
          isAdmin()
        );

        allow list: if (
          isSignedIn() &&
          resource.data.orderId == orderId && (
            resource.data.customerUid == request.auth.uid ||
            resource.data.restaurantOwnerUid == request.auth.uid
          )
        ) || isAdmin();

        allow create: if isVerified()
          && isValidId(orderId)
          && isValidId(itemId)
          && isValidOrderLineItem(incoming())
          && incoming().id == itemId
          && incoming().orderId == orderId
          && incoming().customerUid == request.auth.uid
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/orders/$(orderId))
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.restaurantOwnerUid == incoming().restaurantOwnerUid;

        allow update: if isAdmin()
          && isValidId(orderId)
          && isValidId(itemId)
          && isValidOrderLineItem(incoming());

        allow delete: if isAdmin() && isValidId(orderId) && isValidId(itemId);
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().userUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if (
        isSignedIn() && resource.data.userUid == request.auth.uid
      ) || isAdmin();

      allow create: if isVerified()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().id == notificationId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().userUid == request.auth.uid || isAdmin());

      allow update: if isVerified()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().userUid == existing().userUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().userUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(notificationId);
    }
  }
}
